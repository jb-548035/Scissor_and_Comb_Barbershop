@page "/change-password"
@using hair.Components.Layout
@using hair.Services
@layout LoginLayout
@inject NavigationManager Navigation
@inject AuthStateService AuthStateService
@inject AuthenticationService AuthService

<div class="change-password-container">
    <div class="change-password-card">
        <div class="change-password-header">
            <h1>Change Password</h1>
            <p>You are required to change your password on first login</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-error">
                <i class="bi bi-exclamation-circle"></i>
                <span>@errorMessage</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle"></i>
                <span>@successMessage</span>
            </div>
        }

        <form class="change-password-form" @onsubmit="HandleChangePassword">
            <div class="form-group">
                <label for="currentPassword">Current Password</label>
                <div class="password-wrapper">
                    <input type="@(showCurrentPassword ? "text" : "password")"
                           id="currentPassword"
                           class="form-input"
                           placeholder="Enter your current password"
                           @bind="changePasswordRequest.CurrentPassword"
                           required />
                    <button type="button"
                            class="toggle-password"
                            @onclick="ToggleCurrentPasswordVisibility">
                        <i class="bi @(showCurrentPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label for="newPassword">New Password</label>
                <div class="password-wrapper">
                    <input type="@(showNewPassword ? "text" : "password")"
                           id="newPassword"
                           class="form-input"
                           placeholder="Enter your new password"
                           @bind="changePasswordRequest.NewPassword"
                           @bind:event="oninput"
                           required />
                    <button type="button"
                            class="toggle-password"
                            @onclick="ToggleNewPasswordVisibility">
                        <i class="bi @(showNewPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(changePasswordRequest.NewPassword))
                {
                    <div class="password-strength">
                        <div class="strength-bar">
                            <div class="strength-fill @GetPasswordStrengthClass()" style="width: @GetPasswordStrengthPercentage()%"></div>
                        </div>
                        <p class="strength-text @GetPasswordStrengthClass()">
                            @GetPasswordStrengthMessage()
                        </p>
                    </div>

                    @if (GetPasswordStrengthClass() == "weak")
                    {
                        <div class="password-requirements">
                            <p class="requirement @(changePasswordRequest.NewPassword.Length >= 12 ? "met" : "unmet")">
                                <i class="bi @(changePasswordRequest.NewPassword.Length >= 12 ? "bi-check-circle-fill" : "bi-circle")"></i>
                                At least 12 characters
                            </p>
                            <p class="requirement @(HasLetters(changePasswordRequest.NewPassword) ? "met" : "unmet")">
                                <i class="bi @(HasLetters(changePasswordRequest.NewPassword) ? "bi-check-circle-fill" : "bi-circle")"></i>
                                Contains letters (a-z, A-Z)
                            </p>
                            <p class="requirement @(HasNumbers(changePasswordRequest.NewPassword) ? "met" : "unmet")">
                                <i class="bi @(HasNumbers(changePasswordRequest.NewPassword) ? "bi-check-circle-fill" : "bi-circle")"></i>
                                Contains numbers (0-9)
                            </p>
                        </div>
                    }
                }
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirm New Password</label>
                <div class="password-wrapper">
                    <input type="@(showConfirmPassword ? "text" : "password")"
                           id="confirmPassword"
                           class="form-input"
                           placeholder="Confirm your new password"
                           @bind="changePasswordRequest.ConfirmPassword"
                           required />
                    <button type="button"
                            class="toggle-password"
                            @onclick="ToggleConfirmPasswordVisibility">
                        <i class="bi @(showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-change-password" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner"></span>
                    <span>Changing password...</span>
                }
                else
                {
                    <span>Change Password</span>
                }
            </button>
        </form>
    </div>
</div>

@code {
    private ChangePasswordFormData changePasswordRequest = new();
    private bool showCurrentPassword = false;
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;
    private bool isLoading = false;
    private string errorMessage = "";
    private string successMessage = "";

    private class ChangePasswordFormData
    {
        public string CurrentPassword { get; set; } = "";
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }

    protected override void OnInitialized()
    {
        var currentUser = AuthStateService.GetCurrentUser();
        if (currentUser == null || !currentUser.IsLoggedIn)
        {
            Navigation.NavigateTo("/login", true);
        }
    }

    private void ToggleCurrentPasswordVisibility()
    {
        showCurrentPassword = !showCurrentPassword;
    }

    private void ToggleNewPasswordVisibility()
    {
        showNewPassword = !showNewPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword = !showConfirmPassword;
    }

    private bool HasLetters(string password)
    {
        return System.Text.RegularExpressions.Regex.IsMatch(password, @"[a-zA-Z]");
    }

    private bool HasNumbers(string password)
    {
        return System.Text.RegularExpressions.Regex.IsMatch(password, @"[0-9]");
    }

    private string GetPasswordStrengthClass()
    {
        if (string.IsNullOrEmpty(changePasswordRequest.NewPassword))
            return "weak";

        int length = changePasswordRequest.NewPassword.Length;
        bool hasLetters = HasLetters(changePasswordRequest.NewPassword);
        bool hasNumbers = HasNumbers(changePasswordRequest.NewPassword);

        if (length < 12)
            return "weak";
        else if (length < 16 && hasLetters && hasNumbers)
            return "medium";
        else if (length >= 16 && hasLetters && hasNumbers)
            return "strong";
        else
            return "weak";
    }

    private int GetPasswordStrengthPercentage()
    {
        if (string.IsNullOrEmpty(changePasswordRequest.NewPassword))
            return 0;

        int length = changePasswordRequest.NewPassword.Length;
        bool hasLetters = HasLetters(changePasswordRequest.NewPassword);
        bool hasNumbers = HasNumbers(changePasswordRequest.NewPassword);

        if (length < 12)
            return 33;
        else if (length < 16 && hasLetters && hasNumbers)
            return 66;
        else if (length >= 16 && hasLetters && hasNumbers)
            return 100;
        else
            return 33;
    }

    private string GetPasswordStrengthMessage()
    {
        if (string.IsNullOrEmpty(changePasswordRequest.NewPassword))
            return "";

        int length = changePasswordRequest.NewPassword.Length;
        bool hasLetters = HasLetters(changePasswordRequest.NewPassword);
        bool hasNumbers = HasNumbers(changePasswordRequest.NewPassword);

        if (length < 12)
            return "🔴 Weak - Not enough length";
        else if (length < 16 && hasLetters && hasNumbers)
            return "🟡 Medium - Meets minimum but not long";
        else if (length >= 16 && hasLetters && hasNumbers)
            return "🟢 Strong - Very strong password";
        else
            return "🔴 Weak - Missing requirements";
    }

    private async Task HandleChangePassword()
    {
        errorMessage = "";
        successMessage = "";
        isLoading = true;

        try
        {
            var currentUser = AuthStateService.GetCurrentUser();
            if (currentUser == null)
            {
                errorMessage = "User not found";
                isLoading = false;
                return;
            }

            if (string.IsNullOrWhiteSpace(changePasswordRequest.CurrentPassword))
            {
                errorMessage = "Current password is required";
                isLoading = false;
                return;
            }

            if (string.IsNullOrWhiteSpace(changePasswordRequest.NewPassword))
            {
                errorMessage = "New password is required";
                isLoading = false;
                return;
            }

            if (changePasswordRequest.NewPassword != changePasswordRequest.ConfirmPassword)
            {
                errorMessage = "New passwords do not match";
                isLoading = false;
                return;
            }

            if (changePasswordRequest.NewPassword.Length < 12)
            {
                errorMessage = "Password must be at least 12 characters";
                isLoading = false;
                return;
            }

            if (!HasLetters(changePasswordRequest.NewPassword))
            {
                errorMessage = "Password must contain at least one letter";
                isLoading = false;
                return;
            }

            if (!HasNumbers(changePasswordRequest.NewPassword))
            {
                errorMessage = "Password must contain at least one number";
                isLoading = false;
                return;
            }

            var (success, message) = await AuthService.ChangePasswordAsync(
                currentUser.UserId,
                changePasswordRequest.CurrentPassword,
                changePasswordRequest.NewPassword
            );

            if (success)
            {
                successMessage = "Password changed successfully! Redirecting...";
                await Task.Delay(1500);
                // Force navigation without allowing back button
                Navigation.NavigateTo("/dashboard", true);
            }
            else
            {
                errorMessage = message ?? "Failed to change password";
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Change password error: {ex.Message}");
            errorMessage = "An error occurred while changing password";
        }
        finally
        {
            isLoading = false;
        }
    }
}
