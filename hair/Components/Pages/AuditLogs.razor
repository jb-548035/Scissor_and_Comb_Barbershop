    // Helper methods for formatting
    private string FormatAvailabilityDays(string availabilityDays)
    {
        if (string.IsNullOrWhiteSpace(availabilityDays))
            return "Not specified";

        var days = availabilityDays.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(int.Parse)
            .OrderBy(d => d)
            .ToList();

        if (!days.Any())
            return "Not specified";

        var dayNames = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
        var selectedDays = days.Where(d => d >= 1 && d <= 7).Select(d => dayNames[d - 1]);
        
        return string.Join(", ", selectedDays);
    }

    private string FormatTime(string time)
    {
        if (string.IsNullOrWhiteSpace(time))
            return "Not specified";

        if (TimeOnly.TryParse(time, out var timeOnly))
        {
            return timeOnly.ToString("h:mm tt");
        }
        
        return time;
    }
